# 页面标题
VITE_APP_TITLE = Cesium 一张图

# 生产环境配置
VITE_APP_ENV = 'production'

# Cesium一张图/生产环境
VITE_APP_BASE_API = '/prod-api'

# 是否在打包时开启压缩，支持 gzip 和 brotli（GitHub Pages 自动开启服务端压缩，此处留空避免 Windows 下路径过长及 gh-pages 部署报错）
VITE_BUILD_COMPRESS = 

# 开发环境Cesium路径
VITE_CESIUM_BASE_URL = https://www.unpkg.com/cesium@1.144.0/Build/Cesium/
